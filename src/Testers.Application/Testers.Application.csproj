<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Application references the ASP.NET Core shared framework so feature-slice
    endpoint classes can declare an IEndpoint that maps routes via
    IEndpointRouteBuilder. Standard pattern in modern .NET 8 codebases doing
    vertical slice + minimal APIs.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Scrutor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Testers.Domain\Testers.Domain.csproj" />
  </ItemGroup>

</Project>
