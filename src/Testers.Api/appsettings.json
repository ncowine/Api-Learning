{
  "AllowedHosts": "*",

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    }
  },

  "Database": {
    "ConnectionString": "Server=localhost;Port=3306;User Id=testers;Password=changeme;Database=app_db;AllowUserVariables=true;UseAffectedRows=false;Pooling=true;MinimumPoolSize=0;MaximumPoolSize=100;",
    "AppSchema": "app_db",
    "TestPlanSchema": "testplan_db"
  },

  "Rabbit": {
    "Uri": "amqp://guest:guest@localhost:5672/",
    "ExchangeName": "testers.events.v1",
    "PublisherConfirmTimeoutSeconds": 5,
    "OutboxPollIntervalSeconds": 1,
    "OutboxBatchSize": 100
  },

  "Redis": {
    "ConnectionString": "localhost:6379,abortConnect=false",
    "InstanceName": "testers-api:"
  },

  "Okta": {
    "Authority": "https://your-tenant.okta.com/oauth2/default",
    "Audience": "api://default",
    "RequireHttpsMetadata": true
  }
}
